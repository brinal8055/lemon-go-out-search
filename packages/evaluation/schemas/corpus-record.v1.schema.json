{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lemon.local/schemas/evaluation/corpus-record.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_id", "corpus_version", "query", "family", "split", "language", "pair_group_id", "ui_locale", "scope", "request_filters", "evaluation_clock_utc", "hard_constraints", "intended_assertions", "known_item_target", "rationale", "human_review_flags"],
  "properties": {
    "query_id": { "type": "string", "pattern": "^eval-v1-(dev|sealed|adv)-[a-z0-9-]+-[0-9]{2}$" },
    "corpus_version": { "const": "corpus.v1" },
    "query": { "type": "string", "minLength": 1 },
    "family": { "enum": ["canonical_exact_same_name", "verified_colliding_aliases", "prefix", "typo_transposition_accent_spacing", "taxonomy_parent_leaf", "broad_discovery", "semantic_occasion_language", "event_time", "geo_scope_radius", "scarcity_duplicate_state", "broad_concentration"] },
    "split": { "enum": ["DEV", "SEALED", "ADVERSARIAL"] },
    "language": { "enum": ["en", "sv", "mixed", "language-neutral"] },
    "pair_group_id": { "type": ["string", "null"] },
    "ui_locale": { "enum": ["en", "sv"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "scope_slug", "boundary_id", "boundary_version"],
      "properties": {
        "scope_id": { "type": "string", "format": "uuid" },
        "scope_slug": { "const": "jonkoping-municipality" },
        "boundary_id": { "type": "string", "format": "uuid" },
        "boundary_version": { "type": "string", "minLength": 1 }
      }
    },
    "request_filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taxonomy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_id", "slug"],
          "properties": {
            "node_id": { "type": "string", "format": "uuid" },
            "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          }
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude", "radius_meters"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "radius_meters": { "type": "integer", "minimum": 1 }
          }
        },
        "entity_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["PLACE", "EVENT"] } },
        "time_expression": { "type": "string", "minLength": 1 }
      }
    },
    "evaluation_clock_utc": { "type": ["string", "null"], "format": "date-time" },
    "hard_constraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "intended_assertions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "known_item_target": { "type": ["object", "null"] },
    "rationale": { "type": "string", "minLength": 1 },
    "human_review_flags": { "type": "array", "items": { "type": "string" } }
  }
}
