{
  "name": "lemon-going-out-search",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lemon/mobile start",
    "env:check": "node --env-file-if-exists=.env.local scripts/check-env.mjs --target mobile",
    "env:check:edge": "node --env-file-if-exists=.env.local scripts/check-env.mjs --target edge",
    "env:check:deploy": "node --env-file-if-exists=.env.local scripts/check-env.mjs --target deploy",
    "eval:validate-corpus": "node scripts/validate-eval-corpus.mjs",
    "ingest:fixture": "node --experimental-strip-types packages/ingestion-domain/src/cli.ts",
    "ingest:municipal": "node --experimental-strip-types packages/source-adapters/src/jonkoping-utegym-cli.ts",
    "ingest:osm": "node --experimental-strip-types packages/source-adapters/src/osm-cli.ts",
    "dedup:review": "node --experimental-strip-types packages/ingestion-domain/src/duplicate-review-cli.ts",
    "dedup:smoke": "node --experimental-strip-types packages/ingestion-domain/src/duplicate-review-smoke.ts",
    "publish:first-place": "node --experimental-strip-types packages/ingestion-domain/src/publish-first-place-cli.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "test:reference": "node scripts/verify-reference.mjs",
    "test:ingestion": "vitest run tests/unit/ingestion-core.test.ts tests/unit/first-place-publication.test.ts",
    "test:normalization": "vitest run tests/unit/normalization.test.ts",
    "test:security": "node scripts/test-security.mjs",
    "test:api": "pnpm test:api:unit && pnpm test:api:smoke",
    "test:api:unit": "vitest run tests/unit/edge-search.test.ts",
    "test:api:smoke": "node --experimental-strip-types scripts/test-edge.mjs",
    "test:watch": "vitest",
    "mobile:export": "pnpm --filter @lemon/mobile exec expo export --platform android",
    "mobile:smoke": "node --experimental-strip-types scripts/test-mobile.mjs",
    "supabase": "supabase",
    "db:start:bootstrap": "supabase start --exclude gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "edge:serve": "supabase functions serve search --no-verify-jwt"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.13",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "supabase": "2.114.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
