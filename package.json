{
  "name": "lemon-going-out-search",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lemon/mobile start",
    "env:check": "node --env-file-if-exists=.env.local scripts/check-env.mjs --target mobile",
    "env:check:edge": "node --env-file-if-exists=.env.local scripts/check-env.mjs --target edge",
    "env:check:deploy": "node --env-file-if-exists=.env.local scripts/check-env.mjs --target deploy",
    "env:scan-secrets": "node scripts/check-committed-secrets.mjs",
    "eval:validate-corpus": "node scripts/validate-eval-corpus.mjs",
    "eval:dev": "node --experimental-strip-types packages/evaluation/src/evaluate-dev-cli.ts",
    "eval:dev:full": "node --env-file-if-exists=.env --experimental-strip-types scripts/eval03-full-dev.ts",
    "eval:probe-semantic": "node --env-file-if-exists=.env --experimental-strip-types scripts/postcov-semantic-probe.ts",
    "eval:report:day3": "node --experimental-strip-types packages/evaluation/src/eval03-report-cli.ts",
    "eval:review-packet": "node --experimental-strip-types packages/evaluation/src/day2-review-cli.ts",
    "eval:review-packet-v1.1": "node --experimental-strip-types packages/evaluation/src/day2-review-v1-1-cli.ts",
    "eval:review-full-dev": "node --experimental-strip-types packages/evaluation/src/eval03-review-cli.ts",
    "eval:review-postcoverage": "node --experimental-strip-types packages/evaluation/src/eval03-review-cli.ts --phase=day4-postcoverage --artifact-version=1",
    "eval:review-postcoverage-v2": "node --experimental-strip-types packages/evaluation/src/eval03-review-cli.ts --phase=day4-postcoverage --artifact-version=2",
    "final-eval:review-recovery-dev": "node --env-file-if-exists=.env.final-eval --experimental-strip-types packages/evaluation/src/eval03-review-cli.ts --phase=final-eval-recovery --artifact-version=1",
    "eval:audit-dataset": "node --experimental-strip-types packages/evaluation/src/eval03-provenance-audit-cli.ts",
    "eval:reconstruct-dataset": "node --experimental-strip-types packages/source-adapters/src/eval03-reconstruct-cli.ts",
    "eval:freeze-day2-judgments": "node --experimental-strip-types packages/evaluation/src/freeze-day2-judgments.ts",
    "eval:freeze-day3-judgments": "node --experimental-strip-types packages/evaluation/src/freeze-day3-judgments.ts",
    "eval:freeze-postcoverage-judgments": "node --experimental-strip-types packages/evaluation/src/freeze-postcoverage-judgments.ts",
    "ingest:fixture": "node --experimental-strip-types packages/ingestion-domain/src/cli.ts",
    "ingest:municipal": "node --experimental-strip-types packages/source-adapters/src/jonkoping-utegym-cli.ts",
    "ingest:osm": "node --experimental-strip-types packages/source-adapters/src/osm-cli.ts",
    "source:smoke:event": "node --experimental-strip-types packages/source-adapters/src/jonkoping-events-cli.ts",
    "ingest:event": "node --experimental-strip-types packages/source-adapters/src/jonkoping-event-ingest-cli.ts",
    "expire:events": "node --experimental-strip-types packages/source-adapters/src/expire-events-cli.ts",
    "dedup:review": "node --experimental-strip-types packages/ingestion-domain/src/duplicate-review-cli.ts",
    "dedup:smoke": "node --experimental-strip-types packages/ingestion-domain/src/duplicate-review-smoke.ts",
    "provenance:revocation": "node --experimental-strip-types packages/ingestion-domain/src/provenance-revocation-cli.ts",
    "taxonomy:apply": "node --experimental-strip-types packages/ingestion-domain/src/taxonomy-cli.ts apply-mappings",
    "taxonomy:manual": "node --experimental-strip-types packages/ingestion-domain/src/taxonomy-cli.ts manual-add",
    "coverage:generate": "node --experimental-strip-types scripts/coverage-report.ts",
    "coverage:audit": "node --experimental-strip-types packages/ingestion-domain/src/coverage01-audit-cli.ts",
    "coverage:publish": "node --experimental-strip-types packages/source-adapters/src/publish-eligible-places-cli.ts",
    "coverage:finalize-evidence": "node --experimental-strip-types packages/ingestion-domain/src/coverage01-finalize-cli.ts",
    "coverage:smoke": "node --experimental-strip-types packages/evaluation/src/coverage01-search-smoke-cli.ts",
    "search-documents:rebuild": "node --experimental-strip-types packages/search-documents/src/cli.ts",
    "embeddings:smoke": "node --env-file-if-exists=.env --experimental-strip-types packages/embedding/src/cli.ts",
    "embeddings:preflight": "pnpm embeddings:smoke",
    "embeddings:generate": "node --env-file-if-exists=.env --experimental-strip-types packages/embedding/src/generate-cli.ts",
    "embeddings:report": "node --experimental-strip-types packages/embedding/src/report-cli.ts",
    "diagnose-search": "node --experimental-strip-types packages/evaluation/src/diagnose-search-cli.ts",
    "publish:first-place": "node --experimental-strip-types packages/ingestion-domain/src/publish-first-place-cli.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "node scripts/run-test-vitest.mjs run --no-file-parallelism",
    "test:db": "node --env-file-if-exists=.env.test --experimental-strip-types scripts/test-db.mjs",
    "test:reference": "node scripts/verify-reference.mjs",
    "test:ingestion": "node scripts/run-test-vitest.mjs run tests/unit/ingestion-core.test.ts tests/unit/first-place-publication.test.ts",
    "test:taxonomy": "node scripts/run-test-vitest.mjs run tests/unit/taxonomy.test.ts",
    "test:search-documents": "node scripts/run-test-vitest.mjs run tests/unit/search-documents.test.ts",
    "test:embeddings": "node scripts/run-test-vitest.mjs run tests/unit/embedding-client.test.ts tests/unit/embedding-generator.test.ts && pnpm test:db -- embedding-lifecycle",
    "test:semantic": "node scripts/run-test-vitest.mjs run tests/unit/semantic-query.test.ts tests/unit/edge-search.test.ts && pnpm test:db -- semantic-search && pnpm test:db -- search-diagnostics",
    "test:event-source": "vitest run tests/unit/jonkoping-event-source.test.ts",
    "test:event-ingestion": "node scripts/run-test-vitest.mjs run tests/unit/jonkoping-event-ingestion.test.ts",
    "test:normalization": "node scripts/run-test-vitest.mjs run tests/unit/normalization.test.ts",
    "test:security": "node scripts/test-security.mjs",
    "test:api": "pnpm test:api:unit && pnpm test:api:smoke",
    "test:api:unit": "vitest run tests/unit/edge-search.test.ts",
    "test:api:smoke": "node --env-file-if-exists=.env.test --experimental-strip-types scripts/test-edge.mjs",
    "test:watch": "node scripts/run-test-vitest.mjs",
    "mobile:export": "pnpm --filter @lemon/mobile exec expo export --platform android",
    "mobile:smoke": "node --experimental-strip-types scripts/test-mobile.mjs",
    "supabase": "supabase",
    "db:start:bootstrap": "supabase start --exclude gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "node --env-file-if-exists=.env.test --experimental-strip-types scripts/reset-local-db.mjs",
    "final-eval:migrations:dry-run": "node --env-file-if-exists=.env.final-eval --experimental-strip-types scripts/final-eval-migrations.mjs --dry-run",
    "final-eval:migrations:deploy": "node --env-file-if-exists=.env.final-eval --experimental-strip-types scripts/final-eval-migrations.mjs --apply",
    "final-eval:reference:deploy": "node --env-file-if-exists=.env.final-eval --experimental-strip-types scripts/final-eval-reference-deploy.mjs",
    "final-eval:edge:deploy": "node --env-file-if-exists=.env.final-eval --experimental-strip-types scripts/final-eval-edge-deploy.mjs",
    "final-eval:recovery-a": "node --env-file-if-exists=.env.final-eval --experimental-strip-types packages/source-adapters/src/final-eval-recovery-a-cli.ts",
    "final-eval:recovery-b": "node --env-file-if-exists=.env --env-file-if-exists=.env.final-eval --experimental-strip-types packages/embedding/src/final-eval-recovery-b-cli.ts",
    "final-eval:checkpoint": "node --env-file-if-exists=.env.final-eval --experimental-strip-types scripts/final-eval-checkpoint.mjs",
    "edge:serve": "supabase functions serve --no-verify-jwt"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.13",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "supabase": "2.114.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
