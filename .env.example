# Public mobile configuration. This is a URL, never a database credential.
EXPO_PUBLIC_LEMON_SEARCH_EDGE_URL=

# LOCAL_TEST. Put these values in .env.test; only explicit local test commands may use them.
DB_TARGET=
ALLOW_DESTRUCTIVE_DB_TESTS=
LEMON_LOCAL_DATABASE_URL=

# Edge-only secrets. Configure these in the Edge runtime, never in Expo.
SUPABASE_URL=
LEMON_SUPABASE_SECRET_KEY=
VOYAGE_API_KEY=

# Local deployment tooling.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=

# FINAL_EVAL. Put these values in .env.final-eval; never combine with destructive-test flags.
LEMON_FINAL_EVAL_DATABASE_URL=
ALLOW_FINAL_EVAL_WRITES=
FINAL_EVAL_WRITE_OPERATION=
ALLOW_FINAL_EVAL_BACKUP=
