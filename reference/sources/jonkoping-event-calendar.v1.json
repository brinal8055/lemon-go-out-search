  "reuseAuthority": "Municipal open-data/PSI statement with engineer-approved four-day trial interpretation",
  "attribution": "Jönköpings kommun",
  "persistencePermission": "EXTRACTED_FIELDS_ONLY",
  "permittedFields": [
    "sourceEventUuid",
    "externalKey",
    "title",
    "start",
    "end",
    "timeZone",
    "venueName",
    "city",
    "address",
    "latitude",
    "longitude",
    "categories",
    "sourceUrl",
    "status"
  ],
  "prohibitedFields": [
    "editorialDescription",
    "marketingCopy",
    "images",
    "imageCopyrightText",
    "applicantIdentity",
    "applicantContact",
    "organizerPersonalContact"
  ],
  "access": "Public Sitevision search route plus bounded official Event detail pages",
  "authentication": "NONE",
  "refreshMode": "DELTA_ONLY",
